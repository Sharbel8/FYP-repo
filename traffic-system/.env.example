# Copy this file to .env and adjust values for your machine.
# Never commit .env — it may contain local paths and ports.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=traffic_system

# Camera: integer index (0 = default webcam) or path to a video file
CAMERA_SOURCE=0

# Arduino serial (Windows example: COM3; Linux: /dev/ttyUSB0)
ARDUINO_PORT=COM3
ARDUINO_BAUD_RATE=9600
# Keep true until real hardware is connected
ARDUINO_MOCK_ENABLED=true
